{
    "name": "led-lib",
    "version": "1.0.1",
    "description": "Bare-metal LED control library for 4 independent LEDs: per-LED state machines (off/on/on-for/blink/sequences), 12 global effects, auto-stop repeats. C99, no RTOS, no malloc, ~97 bytes RAM for library state, GPIO only via user callback.",
    "keywords": [
        "led",
        "blink",
        "bare-metal",
        "embedded",
        "state-machine",
        "effects",
        "ch32v003",
        "stm32",
        "avr",
        "no-rtos"
    ],
    "homepage": "https://github.com/tama18101971/LED_LIB",
    "repository": {
        "type": "git",
        "url": "https://github.com/tama18101971/LED_LIB.git"
    },
    "authors": [
        {
            "name": "tama18101971",
            "email": "tamagotchi@yandex.ru",
            "url": "https://github.com/tama18101971"
        }
    ],
    "license": "MIT",
    "platforms": "*",
    "frameworks": "*",
    "headers": "led.h",
    "src_filter": "+<src/>",
    "build": {
        "flags": "-std=c99"
    }
}